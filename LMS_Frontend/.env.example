# Crescent Foundry LMS - frontend configuration template.
#
# Copy to LMS_Frontend/.env.local (git-ignored) to override defaults.
# Variables starting with VITE_ are embedded in the browser bundle: never put
# secrets in them.

# Base URL the browser uses for API calls. The default "/api/v1" keeps the API
# on the same origin; the Vite dev server proxies /api to the backend.
# A full URL (e.g. http://localhost:8000/api/v1) also works, but then the
# backend must list this frontend's origin in LMS_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api/v1

# How often, in milliseconds, the connectivity indicator re-checks the API.
# Minimum 5000.
VITE_HEALTH_POLL_INTERVAL_MS=30000

# Dev/preview server only (NOT exposed to the browser): where /api is proxied.
LMS_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
