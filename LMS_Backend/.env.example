# Crescent Foundry LMS - backend configuration template.
#
# Copy this file to LMS_Backend/.env and fill in values for your environment.
# NEVER commit .env. Never put real credentials in this example file.
# Every variable uses the LMS_ prefix so that settings belonging to other
# systems on the same machine (e.g. the PMS) are never picked up by accident.
#
# Blank values (LMS_X=) are treated as "not set": optional settings use their
# defaults, and required settings stop start-up with "LMS_X is required".
# Quote values containing #, $, spaces or quotes with single quotes: 'a#b$c'.

# --- Application -----------------------------------------------------------
# development | test | staging | production
LMS_ENVIRONMENT=development
LMS_API_V1_PREFIX=/api/v1
# Interactive API docs at /api/docs. Blank = default (on outside production).
LMS_ENABLE_API_DOCS=

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LMS_LOG_LEVEL=INFO
# json (structured, for servers) | console (readable, for local development)
LMS_LOG_FORMAT=console

# --- Security (REQUIRED) -------------------------------------------------------
# Server secret (>= 32 characters) for HMAC-derived values (CSRF tokens, login
# throttle keys). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone's CSRF tokens anew (pages refetch them) and resets
# login throttle counters.
LMS_SECRET_KEY=
# Comma-separated origins allowed to send state-changing requests (CSRF origin
# check). Must include the address users open in the browser.
LMS_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origins allowed for cross-origin browser calls (CORS). Not needed when the
# frontend proxies /api (the default setup). Wildcards are rejected.
LMS_CORS_ALLOWED_ORIGINS=

# --- Sessions ------------------------------------------------------------------
# Secure cookies require HTTPS. Set to false ONLY for local http development;
# production refuses to start unless this is true.
LMS_SESSION_COOKIE_SECURE=true
# lax | strict
LMS_SESSION_COOKIE_SAMESITE=lax
# Sign-out after inactivity (5-480 minutes) and maximum session length (1-72 hours).
LMS_SESSION_IDLE_TIMEOUT_MINUTES=30
LMS_SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# --- Passwords and login throttling ---------------------------------------------
LMS_PASSWORD_MIN_LENGTH=12
LMS_LOGIN_MAX_FAILURES_PER_IDENTIFIER=5
LMS_LOGIN_MAX_FAILURES_PER_IP=20
LMS_LOGIN_FAILURE_WINDOW_MINUTES=15
LMS_LOGIN_LOCKOUT_MINUTES=15

# --- Business calendar -------------------------------------------------------------
# UTC offset (minutes) used to decide "today" for effective-dated organisation data.
# Default 330 = India Standard Time (UTC+05:30).
LMS_BUSINESS_UTC_OFFSET_MINUTES=330

# --- Database: runtime account (restricted, data access only) -------------------
# Dedicated LMS database. Do NOT reuse PMS database names or credentials.
# Either set all four of HOST/NAME/USER/PASSWORD or none of them.
LMS_DB_HOST=
LMS_DB_PORT=3306
LMS_DB_NAME=
LMS_DB_USER=
LMS_DB_PASSWORD=

# Connection behaviour (defaults shown).
LMS_DB_CONNECT_TIMEOUT_SECONDS=5
LMS_DB_QUERY_TIMEOUT_SECONDS=30
LMS_DB_POOL_SIZE=5
LMS_DB_MAX_OVERFLOW=10
LMS_DB_POOL_RECYCLE_SECONDS=1800
# Log every SQL statement (development troubleshooting only).
LMS_DB_ECHO_SQL=false

# --- Database: migration account (Alembic only) ----------------------------------
# Schema-change account used ONLY by Alembic (same host/port/database as above).
# Must differ from LMS_DB_USER. The application never uses it at runtime.
LMS_MIGRATION_DB_USER=
LMS_MIGRATION_DB_PASSWORD=
