# Crescent Foundry LMS - backend configuration template.
#
# Copy this file to LMS_Backend/.env and fill in values for your environment.
# NEVER commit .env. Never put real credentials in this example file.
# Every variable uses the LMS_ prefix so that settings belonging to other
# systems on the same machine (e.g. the PMS) are never picked up by accident.

# --- Application -----------------------------------------------------------
# development | test | staging | production
LMS_ENVIRONMENT=development
LMS_API_V1_PREFIX=/api/v1
# Interactive API docs at /api/docs. Leave blank for the default
# (enabled outside production, disabled in production).
LMS_ENABLE_API_DOCS=

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LMS_LOG_LEVEL=INFO
# json (structured, for servers) | console (readable, for local development)
LMS_LOG_FORMAT=console

# --- CORS --------------------------------------------------------------------
# Comma-separated list of exact origins allowed to call the API from a browser.
# Not needed when the frontend dev server proxies /api (the default setup).
# Wildcards are rejected.
LMS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database: dedicated LMS MySQL 8 database --------------------------------
# Leave ALL of these blank until a dedicated LMS database and a least-privilege
# LMS user have been provisioned. Do NOT reuse PMS database names or credentials.
# Either set all four of HOST/NAME/USER/PASSWORD or none of them.
LMS_DB_HOST=
LMS_DB_PORT=3306
LMS_DB_NAME=
LMS_DB_USER=
LMS_DB_PASSWORD=

# Connection behaviour (defaults shown).
LMS_DB_CONNECT_TIMEOUT_SECONDS=5
LMS_DB_QUERY_TIMEOUT_SECONDS=30
LMS_DB_POOL_SIZE=5
LMS_DB_MAX_OVERFLOW=10
LMS_DB_POOL_RECYCLE_SECONDS=1800
# Log every SQL statement (development troubleshooting only).
LMS_DB_ECHO_SQL=false
