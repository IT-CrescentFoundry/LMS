# Crescent Foundry LMS - automated test database (integration tests only).
#
# Copy this file to LMS_Backend/.env.test (git-ignored) and fill in the password.
# NEVER commit .env.test. These variables are read ONLY by the test harness
# (tests/support/database.py); the application itself never reads them.
#
# Safety rules enforced before any SQL runs:
#   * LMS_TEST_DB_NAME must be exactly "crescent_lms_test" (it must also end with
#     "_test" and differ from the development database, LMS_DB_NAME in .env);
#   * LMS_TEST_DB_USER must be "lms_test";
#   * on every connection, SELECT DATABASE(), CURRENT_USER() must return exactly
#     crescent_lms_test and lms_test@127.0.0.1 - otherwise nothing is executed.
# On every test run the harness drops every table in this database and rebuilds
# it with Alembic (upgrade, downgrade, upgrade; each phase verified). Never point
# it at a database you care about.
#
# The account needs full rights on the test database only (it runs the
# migrations there, including CREATE TRIGGER). Without this file, database
# integration tests are skipped with an explicit reason.

LMS_TEST_DB_HOST=127.0.0.1
LMS_TEST_DB_PORT=3306
LMS_TEST_DB_NAME=crescent_lms_test
LMS_TEST_DB_USER=lms_test
LMS_TEST_DB_PASSWORD=
